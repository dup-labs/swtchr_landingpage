# Template — este arquivo VAI pro git, não ponha segredo aqui. O real mora no .env.
# Credenciais do app criado no portal de parceiros (Chaves de acesso, canto sup. direito)
NUVEMSHOP_APP_ID=
NUVEMSHOP_CLIENT_SECRET=

# Porta do servidor local — precisa bater com a Redirect URL do app:
# http://localhost:8787/auth/callback
PORT=8787

# Vai no User-Agent (obrigatório pra API da Nuvemshop)
CONTACT_EMAIL=dup@dup.agency

URLCALLBACKDEFAULT=https://partners.nuvemshop.com.br/applications/authentication/36078